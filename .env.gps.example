# ---------------------------------------------------------
# GAMENEXA — GPS Maps deployment
# ---------------------------------------------------------

SITE_KEY=gps-maps
SITE_NAME=GPS Maps
SITE_SHORT_NAME=GPS Maps
SITE_TAGLINE=Earth Maps • Navigation • Location Tools

# Replace with the final GPS Maps deployment URL.
SITE_URL=https://gps.example.com

SITE_THEME_KEY=gps-maps-navigation
SITE_MEDIA_FOLDER=gps-maps
SITE_ADMIN_LOGO_URL=/gps-maps-icon.svg

# ---------------------------------------------------------
# MongoDB
# ---------------------------------------------------------

MONGODB_URI=
MONGODB_DB=gps_maps_website

# ---------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------

ADMIN_SESSION_SECRET=

CMS_BOOTSTRAP_ADMIN_EMAIL=
CMS_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------
# One-time bootstrap safety confirmations
# Must exactly match the deployment above.
# ---------------------------------------------------------

CMS_BOOTSTRAP_CONFIRM_SITE_KEY=gps-maps
CMS_BOOTSTRAP_CONFIRM_DATABASE=gps_maps_website
CMS_BOOTSTRAP_CONFIRM_SITE_URL=https://gps.example.com
CMS_BOOTSTRAP_CONFIRM_APPLY=CREATE_EMPTY_SITE

# ---------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
